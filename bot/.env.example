# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o GitHub.

# Chaves (cole as suas)
ANTHROPIC_API_KEY=
GOOGLE_PLACES_KEY=

# Você
MEU_NOME=
EMPRESA=
# Seu WhatsApp pessoal: o robô te avisa aqui quando um lead quiser fechar (só números, com DDD)
MEU_WHATS=
PRECO=250
MENSALIDADE=0

# Onde e o que minerar
CIDADE=Foz do Iguaçu, PR
CATEGORIAS=Barbearia,Salão de beleza,Clínica de estética,Manicure,Hamburgueria,Pizzaria,Açaíteria,Lanchonete,Restaurante,Academia,Pet shop,Oficina mecânica,Lava jato,Dentista,Fisioterapia,Loja de roupas,Ótica,Assistência técnica de celular

# Ritmo anti-ban (mensagens NOVAS por dia: começa baixo e sobe aos poucos)
INICIO_POR_DIA=8
AUMENTO_POR_DIA=4
MAXIMO_POR_DIA=40
HORA_INICIO=9
HORA_FIM=18
# 0=domingo ... 6=sábado (dias em que o robô inicia conversas)
DIAS_ATIVOS=1,2,3,4,5,6
# Respostas a quem já está conversando podem sair num horário mais amplo
RESPOSTA_INICIO=8
RESPOSTA_FIM=21

# Follow-ups para quem não respondeu (dias)
FOLLOWUP1_DIAS=2
FOLLOWUP2_DIAS=5

# Link das prévias (seu GitHub Pages ou domínio próprio)
DEMO_BASE=https://eiyago.github.io/leadsite-v2/

# Porta do painel local (o app sincroniza a pipeline por aqui)
PORTA=3210

# Supabase (opcional): espelho dos leads na nuvem
SUPABASE_URL=
SUPABASE_KEY=
